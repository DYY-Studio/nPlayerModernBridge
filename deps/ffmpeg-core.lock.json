{
  "schema": 1,
  "target": "arm64-apple-ios13.0",
  "sources": {
    "ffmpeg-core": {
      "version": "4.4.8",
      "url": "https://ffmpeg.org/releases/ffmpeg-4.4.8.tar.xz",
      "archive_sha256": "c73848c4ae283d9eaee7be3b276affbc3543380483555500d0dd2c9b7e1c39c3",
      "archive_name": "ffmpeg-4.4.8.tar.xz"
    },
    "dav1d": {
      "version": "0.9.2",
      "url": "https://download.videolan.org/pub/videolan/dav1d/0.9.2/dav1d-0.9.2.tar.xz",
      "archive_sha256": "e3235ab6c43c0135b0db1d131e1923fad4c84db9d85683e30b91b33a52d61c71",
      "archive_name": "dav1d-0.9.2.tar.xz",
      "build_options": {
        "enable_asm": true,
        "enable_tools": false,
        "enable_tests": false,
        "enable_examples": false,
        "logging": true,
        "bitdepths": "8,16"
      }
    }
  },
  "prefix": "build/deps/ffmpeg-core",
  "include_root": "build/deps/ffmpeg-core/include",
  "lib_root": "build/deps/ffmpeg-core/lib",
  "pkgconfig_root": "build/deps/ffmpeg-core/pkgconfig",
  "closure": "build/deps/ffmpeg-core-closure.txt",
  "verification": "build/deps/ffmpeg-core-verification.json",
  "output_archives": [
    "build/deps/ffmpeg-core/lib/libavformat.a",
    "build/deps/ffmpeg-core/lib/libavcodec.a",
    "build/deps/ffmpeg-core/lib/libswresample.a",
    "build/deps/ffmpeg-core/lib/libswscale.a",
    "build/deps/ffmpeg-core/lib/libdav1d.a",
    "build/deps/ffmpeg-core/lib/libavutil.a"
  ],
  "system_link_args": [
    "-lz",
    "-lbz2",
    "-liconv",
    "-framework",
    "VideoToolbox",
    "-framework",
    "CoreMedia",
    "-framework",
    "CoreVideo",
    "-framework",
    "Security",
    "-framework",
    "CoreFoundation",
    "-framework",
    "CoreServices"
  ],
  "configure_args": [
    "--prefix={prefix}",
    "--target-os=darwin",
    "--arch=arm64",
    "--enable-cross-compile",
    "--enable-pic",
    "--cc={cc}",
    "--as={cc}",
    "--ar={ar}",
    "--ranlib={ranlib}",
    "--nm={nm}",
    "--strip={strip}",
    "--sysroot={sdk}",
    "--extra-cflags={cflags} -I{dav1d_include}",
    "--extra-ldflags={ldflags} -L{dav1d_lib}",
    "--pkg-config-flags=--static",
    "--disable-autodetect",
    "--disable-doc",
    "--disable-programs",
    "--disable-avdevice",
    "--disable-avfilter",
    "--disable-postproc",
    "--disable-shared",
    "--enable-static",
    "--enable-swscale",
    "--enable-zlib",
    "--enable-bzlib",
    "--enable-iconv",
    "--enable-videotoolbox",
    "--enable-securetransport",
    "--enable-libdav1d"
  ]
}
